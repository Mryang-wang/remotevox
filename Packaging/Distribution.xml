<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>RemoteVox</title>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="27.0"/>
        </allowed-os-versions>
    </volume-check>
    <welcome file="Welcome.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="app"/>
        <line choice="audio"/>
    </choices-outline>
    <choice id="app" visible="false"><pkg-ref id="local.codex.t1microphone.pkg"/></choice>
    <choice id="audio" visible="false"><pkg-ref id="local.codex.audio.T1SiriInput.pkg"/></choice>
    <pkg-ref id="local.codex.t1microphone.pkg">RemoteVox.pkg</pkg-ref>
    <pkg-ref id="local.codex.audio.T1SiriInput.pkg" onConclusion="RequireRestart">T1Audio.pkg</pkg-ref>
</installer-gui-script>
